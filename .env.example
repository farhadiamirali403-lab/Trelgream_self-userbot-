# =========================================================
# Telegram Userbot SaaS — environment template
# هیچ مقدار واقعی در این فایل قرار ندهید. آن را کپی کنید:
#   Copy-Item .env.example .env
# =========================================================

APP_ENV=development
DEBUG=true

# PostgreSQL (psycopg3 async)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/telegram_saas

# Redis
REDIS_URL=redis://localhost:6379/0

# Telegram credentials (از https://my.telegram.org بگیرید)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Central Bot token (از @BotFather)
CENTRAL_BOT_TOKEN=

# پروکسی تلگرام (اختیاری — اگر تلگرام در شبکه شما مسدود است)
# مثال: socks5://127.0.0.1:1080
TELEGRAM_PROXY=

# کلید رمزنگاری نشست‌ها — تولید با:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=

# کلید دسترسی API ادمین (برای REST API)
ADMIN_API_KEY=

# آدرس عمومی بک‌اند برای لینک احراز هویت وب (خالی = تشخیص خودکار IP محلی)
WEB_BASE_URL=
BACKEND_PORT=8000

# شناسه عددی تلگرام مالک (Owner)
OWNER_TELEGRAM_ID=

# تنظیمات پرداخت کارت به کارت
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_OWNER=

# مسیر ذخیره‌سازی فایل‌ها (رسیدها و ...)
STORAGE_PATH=./storage

# محدودیت‌ها / آستانه‌ها (اختیاری)
LOGIN_RATE_LIMIT=5
CODE_VERIFY_RATE_LIMIT=3
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TIMEOUT=60
SCHEDULER_TICK_SECONDS=60
